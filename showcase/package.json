{
  "name": "fitflex-showcase",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5174",
    "typecheck": "tsc --noEmit",
    "video:studio": "remotion studio src/remotion/index.ts",
    "video:still": "remotion still src/remotion/index.ts FitFlexShowcase out/still.png --frame=300",
    "video:render": "remotion render src/remotion/index.ts FitFlexShowcase out/fitflex-showcase.mp4"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "remotion": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
